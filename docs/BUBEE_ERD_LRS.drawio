  <diagram id="diagram_guide" name="3. Panduan Alur Presentasi">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="g_0" />
        <mxCell id="g_1" parent="g_0" />
        <mxCell id="step_1" value="&lt;b style=&quot;font-size:14px;color:#3B82F6;&quot;&gt;TAHAP 1: MODUL 1: AUTENTIKASI PENGGUNA&lt;/b&gt;&lt;br&gt;&lt;b&gt;Tabel Terkait:&lt;/b&gt; &lt;i&gt;users, otps, activity_logs&lt;/i&gt;&lt;br&gt;&lt;br&gt;Pembeli / Reseller mendaftar, verifikasi OTP 6 digit, lalu login. Sistem mencatat audit trail di activity_logs." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#3B82F6;strokeWidth=2;align=left;spacing=14;" vertex="1" parent="g_1">
          <mxGeometry x="60" y="80" width="320" height="240" as="geometry" />
        </mxCell>
        <mxCell id="step_2" value="&lt;b style=&quot;font-size:14px;color:#10B981;&quot;&gt;TAHAP 2: MODUL 2: KATALOG & VARIAN PRODUK&lt;/b&gt;&lt;br&gt;&lt;b&gt;Tabel Terkait:&lt;/b&gt; &lt;i&gt;products, product_variants, product_images, product_prices&lt;/i&gt;&lt;br&gt;&lt;br&gt;Master produk memiliki banyak varian (ukuran 600ml-1200ml & 8 warna). Galeri foto menyimpan foto varian & detail tutup." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#10B981;strokeWidth=2;align=left;spacing=14;" vertex="1" parent="g_1">
          <mxGeometry x="420" y="80" width="320" height="240" as="geometry" />
        </mxCell>
        <mxCell id="step_3" value="&lt;b style=&quot;font-size:14px;color:#F59E0B;&quot;&gt;TAHAP 3: MODUL 3: KERANJANG & TRANSAKSI&lt;/b&gt;&lt;br&gt;&lt;b&gt;Tabel Terkait:&lt;/b&gt; &lt;i&gt;carts, vouchers, orders, order_items, notification_logs&lt;/i&gt;&lt;br&gt;&lt;br&gt;Pembeli memasukkan barang ke carts, menggunakan voucher diskon, lalu checkout menghasilkan order & order_items. WA notif dikirim otomatis." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#F59E0B;strokeWidth=2;align=left;spacing=14;" vertex="1" parent="g_1">
          <mxGeometry x="780" y="80" width="320" height="240" as="geometry" />
        </mxCell>
        <mxCell id="step_4" value="&lt;b style=&quot;font-size:14px;color:#8B5CF6;&quot;&gt;TAHAP 4: MODUL 4: RETUR & ULASAN&lt;/b&gt;&lt;br&gt;&lt;b&gt;Tabel Terkait:&lt;/b&gt; &lt;i&gt;returs, retur_items, reviews&lt;/i&gt;&lt;br&gt;&lt;br&gt;Setelah paket sampai, pembeli bisa memberikan rating & ulasan. Jika paket cacat/rusak, bisa mengajukan komplain returs beserta bukti foto." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#8B5CF6;strokeWidth=2;align=left;spacing=14;" vertex="1" parent="g_1">
          <mxGeometry x="240" y="420" width="320" height="240" as="geometry" />
        </mxCell>
        <mxCell id="step_5" value="&lt;b style=&quot;font-size:14px;color:#84CC16;&quot;&gt;TAHAP 5: MODUL 5: INVENTORI GUDANG&lt;/b&gt;&lt;br&gt;&lt;b&gt;Tabel Terkait:&lt;/b&gt; &lt;i&gt;stock_mutations, penerimaan, penerimaan_items, opname_sesi, opname_items&lt;/i&gt;&lt;br&gt;&lt;br&gt;Stok bertambah saat penerimaan barang dari supplier lolos QC. Mutasi mencatat setiap pergerakan. Stok opname mencocokkan fisik rak dengan sistem." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#84CC16;strokeWidth=2;align=left;spacing=14;" vertex="1" parent="g_1">
          <mxGeometry x="600" y="420" width="320" height="240" as="geometry" />
        </mxCell>
        <mxCell id="flow_1_2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#475569;" edge="1" parent="g_1" source="step_1" target="step_2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="flow_2_3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#475569;" edge="1" parent="g_1" source="step_2" target="step_3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="flow_3_4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#475569;" edge="1" parent="g_1" source="step_3" target="step_4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="flow_4_5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#475569;" edge="1" parent="g_1" source="step_4" target="step_5"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
